# =============================================================================
# Infraestructura OTI — plantilla para desarrollo LOCAL
# Copie a .env:  cp .env.example .env
# No suba .env al repositorio.
# =============================================================================

# Django (local)
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-secret-key-for-local-dev-only
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos local: SQLite (recomendado por ahora)
USE_SQLITE=True

# PostgreSQL (opcional, fase posterior — requiere USE_SQLITE=False)
# DATABASE_URL=postgres://oti_user:oti_password@localhost:5432/infraestructura_oti

# CSRF / sesión (local sin HTTPS)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Autenticación
LOGIN_URL=/login/
LOGIN_REDIRECT_URL=/inicio/
LOGOUT_REDIRECT_URL=/login/

# Correo local: mensajes en la terminal del runserver
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@local.infraestructura-oti

# Módulo Internet (Sprint 04)
INTERNET_SERVICE_EXPIRY_WARNING_DAYS=30
INTERNET_DOCUMENT_MAX_SIZE_MB=10

# -----------------------------------------------------------------------------
# Futuro (institucional / producción) — no activar en local todavía
# -----------------------------------------------------------------------------
# DEBUG=False
# USE_SQLITE=False
# DATABASE_URL=postgres://...
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.institucion.gov.co
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
