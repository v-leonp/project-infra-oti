{
  "name": "infraestructura-oti",
  "private": true,
  "scripts": {
    "build:vendor": "mkdir -p static/vendor && cp node_modules/htmx.org/dist/htmx.min.js static/vendor/htmx.min.js",
    "build:css": "tailwindcss -i ./static/src/input.css -o ./static/css/dist/main.css --minify",
    "build": "npm run build:vendor && npm run build:css",
    "watch:css": "tailwindcss -i ./static/src/input.css -o ./static/css/dist/main.css --watch"
  },
  "devDependencies": {
    "htmx.org": "^2.0.4",
    "tailwindcss": "^3.4.17"
  }
}
